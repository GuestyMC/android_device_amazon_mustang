# LiveDisplay auto night mode applies a warm color matrix that flickers
# whenever the display pipeline switches composition paths (interaction-
# correlated warm flashes). Default the mode to OFF; users can re-enable
# Night Light manually in Settings.
on property:sys.boot_completed=1
    exec_background u:r:su:s0 root root -- /system/bin/sh -c "sleep 15 && content insert --uri content://lineagesettings/system --bind name:s:display_temperature_mode --bind value:i:0 && content insert --uri content://lineagesettings/system --bind name:s:display_color_enhance --bind value:b:0"
