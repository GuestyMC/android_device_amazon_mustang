# MTK audio HAL (Fire OS blob) fails createAudioPatch on Lineage and never
# enables amp/ADC switches. Set them directly once boot completes.
on property:sys.boot_completed=1
    exec_background u:r:su:s0 root root -- /system/bin/sh -c "sleep 10 && tinymix 3 On && tinymix 0 On && tinymix 1 On && tinymix 33 On && tinymix 17 On && tinymix 18 On && tinymix 19 On && tinymix 20 On && tinymix 15 IN_ADC1"
